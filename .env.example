# Copy to .env and fill in. Never commit .env.

# Gateway key your OpenAI clients present as: Authorization: Bearer <key>
WRAPPER_API_KEY=sk-local-change-me

# Subscription token: run `claude setup-token` on your host and paste the output here.
CLAUDE_CODE_OAUTH_TOKEN=

# Optional
CLAUDE_MODEL=claude-opus-4-8
CLAUDE_MAX_TURNS=8

# LLM mode (all also configurable in the /setup UI):
SINGLE_TURN=1        # 1 = plain chat is one prompt -> one response (no agent loop)
DISABLE_THINKING=1   # 1 = skip extended (thinking-block) reasoning
CONCISE=0            # 1 = suppress reasoning narration / step-by-step; answer directly
TOOL_MAX_TURNS=5     # ceiling for tool/structured requests (need a few internal turns)

# Warm pool: pre-spawns single-use CLI clients so process startup happens off the
# request path. Keyed by (mode, model, schema, system prompt, ...).
WARM_POOL=1          # 0 = always cold-spawn (old behavior)
POOL_MAX_KEYS=3      # warm clients kept (one per distinct request shape)
POOL_TTL_S=300       # idle warm clients retired after this many seconds

REQUEST_TIMEOUT=180  # per-request ceiling; returns OpenAI-format timeout error

# Logging: DEBUG shows prompts/thinking/per-block traces, INFO shows request/result/usage
LOG_LEVEL=INFO
