# Copy to .env and fill in. Never commit .env.

# Gateway key your OpenAI clients present as: Authorization: Bearer <key>
WRAPPER_API_KEY=sk-local-change-me

# Subscription token: run `claude setup-token` on your host and paste the output here.
CLAUDE_CODE_OAUTH_TOKEN=

# Optional
CLAUDE_MODEL=claude-opus-4-8
CLAUDE_MAX_TURNS=8

# LLM mode (also toggleable in the /setup UI):
SINGLE_TURN=1        # 1 = one prompt -> one response (no agent loop)
DISABLE_THINKING=1   # 1 = skip extended reasoning

# Logging: DEBUG shows thinking/system messages, INFO shows request/result/usage
LOG_LEVEL=INFO
